---
// Admin konten. Sengaja tidak ditautkan dari situs publik dan tidak diindeks.
export const prerender = true;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | Transbara Wahyu</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Cadangan bila admin gagal dimuat: kumpulkan semua error lalu tampilkan, bukan layar kosong.
      (function () {
        var errors = [];
        window.__adminErrors = errors;
        addEventListener('error', function (e) { errors.push(e.message || (e.target && (e.target.src || e.target.href)) || 'Gagal memuat skrip'); }, true);
        addEventListener('unhandledrejection', function (e) { errors.push(String((e.reason && e.reason.message) || e.reason)); });
        var origError = console.error;
        console.error = function () { try { errors.push([].map.call(arguments, String).join(' ')); } catch (_) {} return origError.apply(console, arguments); };
        setTimeout(function () {
          var root = document.getElementById('admin-root');
          if (root && root.children.length) return;
          var box = document.createElement('div');
          box.style.cssText = 'max-width:560px;margin:15vh auto;padding:24px;font-family:Inter,sans-serif;background:#fff;border-top:2px solid #C5A46D;border-radius:10px;box-shadow:0 8px 24px rgba(13,33,64,.15);color:#1F2733';
          var h = document.createElement('h1');
          h.textContent = 'Admin belum termuat';
          h.style.cssText = 'font-family:Georgia,serif;font-weight:400;color:#16325C;margin:0 0 8px';
          var p = document.createElement('p');
          p.textContent = 'Coba muat ulang dengan Ctrl+Shift+R atau buka di jendela Incognito. Bila tetap kosong, kirimkan keterangan berikut ke pengembang.';
          p.style.cssText = 'margin:0 0 12px;color:#6B7380';
          var pre = document.createElement('pre');
          pre.style.cssText = 'white-space:pre-wrap;font-size:12px;background:#F6F8FB;padding:10px;border-radius:6px';
          pre.textContent = (errors.join('\n') || 'Tidak ada pesan error.') + '\nBrowser: ' + navigator.userAgent;
          box.append(h, p, pre);
          document.body.appendChild(box);
        }, 8000);
      })();
    </script>
  </head>
  <body>
    <div id="admin-root"></div>
    <noscript><p style="padding:24px;font-family:sans-serif">Admin membutuhkan JavaScript. Aktifkan JavaScript di browser Anda.</p></noscript>
    <script>
      // Render langsung (tanpa island) agar kegagalan apa pun tertangkap oleh penangkap error di atas.
      import { h, render } from 'preact';
      import App from '../admin/App';
      render(h(App, {}), document.getElementById('admin-root')!);
    </script>
  </body>
</html>

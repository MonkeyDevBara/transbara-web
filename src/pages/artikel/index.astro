---
import BaseV2 from '../../layouts/BaseV2.astro';
import PageHead from '../../components/v2/PageHead.astro';
import ArticleCard from '../../components/v2/ArticleCard.astro';
import StateBox from '../../components/v2/StateBox.astro';
import Icon from '../../components/v2/Icon.astro';
import { getContent } from '../../lib/content';
import { getArticles, getCategories, safe } from '../../lib/data';

const content = await getContent();
const p = content.page_artikel;
const [articles, categories] = await Promise.all([safe(getArticles, []), safe(getCategories, [])]);
const featured = articles.data.find((a) => a.is_featured) ?? articles.data[0];
// Artikel pilihan ikut di grid, tapi hanya tampil saat filter/pencarian aktif.
const rest = [...articles.data.filter((a) => a !== featured), ...(featured ? [featured] : [])];
const PAGE_SIZE = 6;
const crumbs = [{ name: 'Beranda', href: '/' }, { name: 'Artikel' }];
---
<BaseV2 title="Artikel" description={p.intro} crumbs={crumbs}>
  <PageHead crumbs={crumbs} label={p.label} title={p.title} intro={p.intro} />

  {articles.error ? (
    <section class="container page-body"><StateBox type="error" /></section>
  ) : articles.data.length === 0 ? (
    <section class="container page-body"><StateBox type="empty" title="Belum ada artikel" text="Tulisan pertama sedang disiapkan." /></section>
  ) : (
    <>
      {featured && (
        <section class="container page-body" aria-labelledby="h-pilihan">
          <p class="eyebrow eyebrow--accent reveal" id="h-pilihan" style="margin-bottom:20px">Artikel pilihan</p>
          <div class="reveal"><ArticleCard article={featured} variant="feature" headingLevel="h2" /></div>
        </section>
      )}

      <section class="container section" style="padding-top:clamp(56px,7vw,96px)" aria-label="Semua artikel">
        <div class="a-tools">
          <div class="filters" role="group" aria-label="Filter kategori">
            <button type="button" class="filter" data-cat="" aria-pressed="true">Semua</button>
            {categories.data.map((c) => <button type="button" class="filter" data-cat={c.slug} aria-pressed="false">{c.name}</button>)}
          </div>
          <div class="searchbox">
            <Icon name="search" />
            <label for="cari" class="sr-only">Cari artikel</label>
            <input id="cari" type="search" placeholder="Cari judul atau topik…" autocomplete="off" />
          </div>
        </div>
        <p class="a-count" id="result-count" role="status" aria-live="polite"></p>
        <div class="a-grid" id="article-grid" data-page-size={PAGE_SIZE}>
          {rest.map((a) => {
            const haystack = [a.title, a.excerpt, a.category?.name, ...a.tags.map((t) => t.name)].join(' ').toLowerCase();
            return <div class="article-item" data-featured={a === featured ? '1' : undefined} data-cat={a.category?.slug ?? ''} data-search={haystack}><ArticleCard article={a} headingLevel="h2" /></div>;
          })}
        </div>
        <div id="empty-state" hidden><StateBox type="empty" title="Tidak ada artikel yang cocok" text="Coba kata kunci lain atau pilih kategori Semua." /></div>
        <div style="text-align:center;margin-top:40px"><button type="button" class="btn btn--ghost" id="load-more" hidden>Muat lebih banyak</button></div>
      </section>
    </>
  )}
</BaseV2>

<script>
  const grid = document.getElementById('article-grid');
  if (grid) {
    const PAGE_SIZE = Number(grid.dataset.pageSize) || 6;
    const items = [...document.querySelectorAll<HTMLElement>('.article-item')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
    const search = document.getElementById('cari') as HTMLInputElement | null;
    const loadMore = document.getElementById('load-more') as HTMLButtonElement | null;
    const empty = document.getElementById('empty-state');
    const count = document.getElementById('result-count');
    const params = new URLSearchParams(location.search);
    let cat = params.get('kategori') ?? '';
    let q = params.get('q') ?? '';
    let limit = PAGE_SIZE;
    if (search) search.value = q;

    const render = () => {
      const term = q.trim().toLowerCase();
      const filtering = Boolean(cat || term);
      const matches = items.filter((el) => (filtering || !el.dataset.featured) && (!cat || el.dataset.cat === cat) && (!term || (el.dataset.search ?? '').includes(term)));
      items.forEach((el) => (el.hidden = true));
      matches.slice(0, limit).forEach((el) => (el.hidden = false));
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === cat)));
      if (empty) empty.hidden = matches.length > 0;
      if (loadMore) loadMore.hidden = matches.length <= limit;
      if (count) count.textContent = filtering ? `${matches.length} artikel ditemukan` : '';
      const url = new URL(location.href);
      cat ? url.searchParams.set('kategori', cat) : url.searchParams.delete('kategori');
      term ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      history.replaceState(null, '', url);
    };
    chips.forEach((c) => c.addEventListener('click', () => { cat = c.dataset.cat ?? ''; limit = PAGE_SIZE; render(); }));
    search?.addEventListener('input', () => { q = search.value; limit = PAGE_SIZE; render(); });
    loadMore?.addEventListener('click', () => { limit += PAGE_SIZE; render(); });
    render();
  }
</script>

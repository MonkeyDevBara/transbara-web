---
import Base from '../layouts/Base.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import StateBox from '../components/StateBox.astro';
import CtaBand from '../components/CtaBand.astro';
import { getProjects, safe } from '../lib/data';

const projects = await safe(getProjects, []);
const featured = projects.data.filter((p) => p.status === 'active');
const exploring = projects.data.filter((p) => p.status === 'exploring');
---
<Base title="Proyek" description="Proyek dan eksplorasi Transbara Wahyu, dengan SIDIGS sebagai proyek utama.">
  <section class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb"><ol class="tw-breadcrumb"><li><a href="/">Beranda</a></li><li aria-current="page">Proyek</li></ol></nav>
      <span class="gold-rule"></span>
      <h1>Hal yang Sedang Saya Bangun</h1>
      <p class="section-intro">Proyek-proyek ini adalah cara saya menerjemahkan gagasan menjadi kerja nyata. Fokusnya pada dampak dan proses, bukan sekadar hasil.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {projects.error && <StateBox type="error" />}
      {!projects.error && featured.length === 0 && <StateBox type="empty" title="Belum ada proyek" text="Proyek akan ditampilkan di sini." />}
      {featured.map((p) => <ProjectFeature project={p} detailed />)}
    </div>
  </section>

  {exploring.length > 0 && (
    <section class="section bg-offwhite">
      <div class="container">
        <span class="gold-rule"></span>
        <h2 class="section-title">Sedang Dieksplorasi</h2>
        <p class="section-intro mb-5">Gagasan dan pertanyaan yang sedang saya pelajari. Belum menjadi produk, tetapi terus saya pikirkan.</p>
        <div class="row">
          {exploring.map((p) => (
            <div class="col-md-6 mb-4">
              <div class="explore-item">
                <span class="status">Eksplorasi</span>
                <h3 class="mt-2">{p.name}</h3>
                {p.summary && <p class="mb-2" style="color:#3A4452">{p.summary}</p>}
                {p.description && <p class="text-muted-tw mb-0" style="font-size:.9375rem">{p.description}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title="Punya gagasan untuk dikerjakan bersama?" text="Saya terbuka untuk kolaborasi yang membawa dampak bagi pendidikan dan ekosistem bisnis yang bernilai." />
</Base>

---
import BaseV2 from '../layouts/BaseV2.astro';
import PageHead from '../components/v2/PageHead.astro';
import ContactForm from '../components/v2/ContactForm.astro';
import Icon from '../components/v2/Icon.astro';
import { getContent } from '../lib/content';
import { contactInfo, PROFILE } from '../lib/profile';

const content = await getContent();
const p = content.page_kontak;
const info = contactInfo(content);
const crumbs = [{ name: 'Beranda', href: '/' }, { name: 'Kontak' }];
---
<BaseV2 title="Kontak" description={p.intro} crumbs={crumbs}>
  <PageHead crumbs={crumbs} label={p.label} title={p.title} intro={p.intro} />
  <section class="container page-body">
    <div class="kontak-grid">
      <div class="reveal"><ContactForm /></div>
      <aside class="kontak-side" aria-label="Kontak langsung">
        <p class="eyebrow reveal">Kontak langsung</p>
        <div data-stagger>
          <a class="contact-row reveal" href={`mailto:${info.email}`}><span class="contact-row__ic"><Icon name="mail" /></span><span><span class="contact-row__label">Email</span><span class="contact-row__val">{info.email}</span></span><span class="contact-row__go"><Icon name="arrow-ur" /></span></a>
          <a class="contact-row reveal" href={info.instagram} target="_blank" rel="noopener noreferrer"><span class="contact-row__ic"><Icon name="instagram" /></span><span><span class="contact-row__label">Instagram</span><span class="contact-row__val">{PROFILE.instagramHandle}</span></span><span class="contact-row__go"><Icon name="arrow-ur" /></span></a>
          <a class="contact-row reveal" href={info.linkedin} target="_blank" rel="noopener noreferrer"><span class="contact-row__ic"><Icon name="linkedin" /></span><span><span class="contact-row__label">LinkedIn</span><span class="contact-row__val">{PROFILE.linkedinHandle}</span></span><span class="contact-row__go"><Icon name="arrow-ur" /></span></a>
          <div class="contact-row reveal"><span class="contact-row__ic"><Icon name="pin" /></span><span><span class="contact-row__label">Based in</span><span class="contact-row__val">{content.home_hero.location}</span></span><span></span></div>
        </div>
        {p.note && <p class="kontak-side__note reveal">{p.note}</p>}
      </aside>
    </div>
  </section>
  <script>
    import { initContactForm } from '../scripts/contact-form';
    initContactForm({ source: 'halaman Kontak' });
  </script>
</BaseV2>

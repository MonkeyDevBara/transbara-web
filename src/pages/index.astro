---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SampleLabel from '../components/SampleLabel.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import CtaBand from '../components/CtaBand.astro';
import StateBox from '../components/StateBox.astro';
import Icon from '../components/Icon.astro';
import { getArticles, getProjects, getTopics, safe } from '../lib/data';
import { getContent } from '../lib/content';

const [articles, projects, topics, c] = await Promise.all([
  safe(getArticles, []),
  safe(getProjects, []),
  safe(getTopics, []),
  getContent(),
]);
const featured = articles.data.find((a) => a.is_featured) ?? articles.data[0];
const secondary = articles.data.filter((a) => a !== featured).slice(0, 2);
const mainProject = projects.data.find((p) => p.is_featured);

const quoteAfter = Math.max(0, Number(c.journey.quote_after) || 0);
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-7 pr-lg-5">
          {c.hero.credibility && <p class="hero-credibility">{c.hero.credibility}</p>}
          <h1 class="hero-title">
            {c.hero.headline.map((line) => <span>{line}</span>)}
          </h1>
          <p class="hero-sub">{c.hero.subtext}</p>
          <div class="hero-ctas">
            {c.hero.cta_primary_label && <a href={c.hero.cta_primary_href} class="btn btn-primary">{c.hero.cta_primary_label}</a>}
            {c.hero.cta_secondary_label && <a href={c.hero.cta_secondary_href} class="btn btn-secondary">{c.hero.cta_secondary_label}</a>}
          </div>
        </div>
        <div class="col-lg-5">
          <Portrait eager />
        </div>
      </div>
    </div>
  </section>

  <!-- Sedikit Tentang Saya -->
  <section class="section bg-offwhite">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 mb-4 mb-lg-0">
          <span class="gold-rule"></span>
          <h2 class="section-title">{c.about.title}</h2>
        </div>
        <div class="col-lg-8">
          <p class="lead-serif mb-4">{c.about.intro}</p>
          {c.about.body && <p style="color:#3A4452; font-size:1.0625rem; max-width: 40rem;">{c.about.body}</p>}
          {c.about.link_label && <a href={c.about.link_href} class="text-link mt-2">{c.about.link_label} <Icon name="arrow" size={16} /></a>}
        </div>
      </div>
    </div>
  </section>

  <!-- Area fokus -->
  <section class="section">
    <div class="container">
      <div class="row mb-5">
        <div class="col-lg-7">
          <span class="gold-rule"></span>
          <h2 class="section-title">{c.focus.title}</h2>
          {c.focus.intro && <p class="section-intro">{c.focus.intro}</p>}
        </div>
      </div>
      <ol class="focus-list">
        {c.focus.items.map((f, i) => (
          <li class="focus-item">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Topik bicara -->
  <section class="section bg-navy on-dark" id="topik">
    <div class="container">
      <div class="row align-items-end mb-5">
        <div class="col-lg-7">
          <span class="gold-rule"></span>
          {c.topics.eyebrow && <span class="eyebrow">{c.topics.eyebrow}</span>}
          <h2 class="section-title">{c.topics.title}</h2>
        </div>
        <div class="col-lg-5 text-lg-right mt-3 mt-lg-0">
          {c.topics.cta_label && <a href={c.topics.cta_href} class="btn btn-light-tw">{c.topics.cta_label}</a>}
        </div>
      </div>
      {topics.error ? <StateBox type="error" /> : (
        <>
          {topics.data.filter((t) => t.is_signature).map((t) => (
            <div class="topic topic-signature">
              <span class="t-num">{String(topics.data.indexOf(t) + 1).padStart(2, '0')}</span>
              <div>
                <span class="t-label">{c.topics.signature_label}</span>
                <h3>{t.title}</h3>
                {t.description && <p>{t.description}</p>}
              </div>
            </div>
          ))}
          <div class="topics-grid">
            {topics.data.filter((t) => !t.is_signature).map((t) => (
              <div class="topic">
                <span class="t-num">{String(topics.data.indexOf(t) + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{t.title}</h3>
                  {t.description && <p>{t.description}</p>}
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Artikel -->
  <section class="section">
    <div class="container">
      <div class="d-flex flex-wrap justify-content-between align-items-end mb-5" style="gap:1rem">
        <div>
          <span class="gold-rule"></span>
          <h2 class="section-title mb-2">{c.articles.title}</h2>
          {articles.data.some((a) => a.is_sample) && <SampleLabel />}
        </div>
        <a href="/artikel" class="text-link">{c.articles.link_label} <Icon name="arrow" size={16} /></a>
      </div>
      {articles.error && <StateBox type="error" />}
      {!articles.error && !featured && <StateBox type="empty" title="Belum ada artikel" text="Tulisan pertama sedang disiapkan." />}
      {featured && (
        <div class="row">
          <div class="col-lg-7 mb-5 mb-lg-0">
            <ArticleCard article={featured} variant="feature" />
          </div>
          <div class="col-lg-5 pl-lg-5">
            <div class="d-flex flex-column" style="gap:2.5rem">
              {secondary.map((a) => <ArticleCard article={a} variant="row" />)}
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Perjalanan -->
  <section class="section bg-offwhite">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 mb-4">
          <span class="gold-rule"></span>
          <h2 class="section-title">{c.journey.title}</h2>
        </div>
        <div class="col-lg-7 offset-lg-1">
          {c.journey.paragraphs.map((p, i) => (
            <>
              {c.journey.quote && i === quoteAfter && <blockquote class="pull-quote">{c.journey.quote}</blockquote>}
              <p style="font-size:1.125rem; color:#3A4452">{p}</p>
            </>
          ))}
          {c.journey.quote && quoteAfter >= c.journey.paragraphs.length && <blockquote class="pull-quote">{c.journey.quote}</blockquote>}
        </div>
      </div>
    </div>
  </section>

  <!-- Proyek -->
  <section class="section">
    <div class="container">
      <span class="gold-rule"></span>
      <h2 class="section-title mb-5">{c.projects.title}</h2>
      {mainProject ? <ProjectFeature project={mainProject} /> : <StateBox type={projects.error ? 'error' : 'empty'} title={projects.error ? undefined : 'Belum ada proyek'} />}
    </div>
  </section>

  <CtaBand />
</Base>

---
import BaseV2 from '../layouts/BaseV2.astro';
import Button from '../components/v2/Button.astro';
import SectionHeader from '../components/v2/SectionHeader.astro';
import Accordion from '../components/v2/Accordion.astro';
import CtaBand from '../components/v2/CtaBand.astro';
import QuoteCard from '../components/v2/QuoteCard.astro';
import { getContent } from '../lib/content';
import { getTopics, safe } from '../lib/data';
import { fmtTitle } from '../lib/format';

const content = await getContent();
const { page_tentang: t, home_story: story, home_about: about, home_hero: hero } = content;
const { data: topics } = await safe(getTopics, []);
const words = (l: string[]) => (l ?? []).filter((x) => String(x ?? '').trim());
const timeline = (t.timeline ?? []).filter((x) => String(x.role ?? '').trim());
const edu = (about.education ?? []).filter((x) => String(x.school ?? '').trim());
const crumbs = [{ name: 'Beranda', href: '/' }, { name: 'Tentang' }];
const isDefaultPortrait = hero.portrait.startsWith('/v2/img/portrait-');
---
<BaseV2 title="Tentang" description={t.lead} crumbs={crumbs} ogType="profile">
  <header class="page-head about-hero">
    <div class="container">
      <nav aria-label="Breadcrumb"><ol class="crumbs"><li><a href="/">Beranda</a></li><li><span aria-current="page">Tentang</span></li></ol></nav>
      <div class="page-head__grid">
        <div>
          <p class="eyebrow eyebrow--accent reveal">{t.label}</p>
          <h1 class="display display--xl reveal" set:html={fmtTitle(t.title)}></h1>
          <p class="lead reveal">{t.lead}</p>
          <div class="hero__cta reveal">
            <Button href="/kontak?keperluan=undangan_berbicara" icon="arrow-ur">{t.cta_label}</Button>
            {hero.cv_url && <Button href={hero.cv_url} variant="ghost" icon="download">Download CV</Button>}
          </div>
        </div>
        <div class="about-portrait reveal">
          {isDefaultPortrait
            ? <img src="/v2/img/portrait-768.webp" srcset="/v2/img/portrait-480.webp 480w, /v2/img/portrait-768.webp 768w" sizes="(min-width: 960px) 420px, 80vw" alt={hero.portrait_alt} width="768" height="1223" loading="lazy" decoding="async" />
            : <img src={hero.portrait} alt={hero.portrait_alt} width="881" height="1403" loading="lazy" decoding="async" />}
        </div>
      </div>
    </div>
  </header>

  {words(t.story).length > 0 && (
    <section class="section" id="cerita" aria-labelledby="h-cerita">
      <div class="container">
        <div class="story-text">
          <div class="story-text__side"><div><h2 class="display display--lg reveal" id="h-cerita" set:html={fmtTitle(t.story_title)}></h2></div></div>
          <div class="story-text__body" data-stagger>{words(t.story).map((p) => <p class="reveal">{p}</p>)}</div>
        </div>
      </div>
    </section>
  )}

  <section class="section" id="nilai" aria-labelledby="h-nilai">
    <div class="container">
      <SectionHeader label="Nilai" id="h-nilai"><Fragment set:html={fmtTitle(story.values_label)} /></SectionHeader>
      <div class="story-text" style="margin-bottom:40px">
        <div></div>
        <p class="lead reveal">{story.body}</p>
      </div>
      <div class="values-row" data-stagger>
        {words(story.values).map((v, i) => <div class="value-card reveal"><span>{String(i + 1).padStart(2, '0')}</span><h3>{v}</h3></div>)}
      </div>
    </div>
  </section>

  {timeline.length > 0 && (
    <section class="section" id="perjalanan" aria-labelledby="h-perjalanan">
      <div class="container">
        <SectionHeader label="Riwayat" id="h-perjalanan"><Fragment set:html={fmtTitle(t.timeline_title)} /></SectionHeader>
        <Accordion items={timeline} label="Riwayat perjalanan lengkap" />
      </div>
    </section>
  )}

  <section class="section" id="pendidikan" aria-labelledby="h-pendidikan">
    <div class="container">
      <SectionHeader label="Latar belakang" id="h-pendidikan"><Fragment set:html={fmtTitle(about.education_title)} /></SectionHeader>
      <div class="split2">
        <div class="reveal">
          <ul class="edu">{edu.map((e) => <li><em>{e.years}</em><b>{e.school}</b><span>{e.program}</span></li>)}</ul>
        </div>
        <div class="reveal">
          {words(about.skills).length > 0 && <><p class="eyebrow sub-label" style="margin-top:0">Keahlian</p><div class="chips">{words(about.skills).map((s) => <span class="chip">{s}</span>)}</div></>}
          {words(about.languages).length > 0 && <><p class="eyebrow sub-label">Bahasa</p><div class="chips">{words(about.languages).map((s) => <span class="chip" lang={/[؀-ۿ]/.test(s) ? 'ar' : undefined}>{s}</span>)}</div></>}
          {words(about.certifications).length > 0 && <><p class="eyebrow sub-label">Sertifikasi</p><div class="chips">{words(about.certifications).map((s) => <span class="chip chip--accent">{s}</span>)}</div></>}
        </div>
      </div>
      <div style="margin-top:56px"><QuoteCard sign={about.signature} foot={about.quote_foot}>{about.quote}</QuoteCard></div>
    </div>
  </section>

  {topics.length > 0 && (
    <section class="section" id="topik" aria-labelledby="h-topik">
      <div class="container">
        <SectionHeader label={t.topics_text} id="h-topik"><Fragment set:html={fmtTitle(t.topics_title)} /></SectionHeader>
        <div class="topics" data-stagger>
          {topics.map((tp) => (
            <div class="topic reveal">
              <div><h3>{tp.title}</h3>{tp.is_signature && <span class="chip chip--accent">Topik andalan</span>}</div>
              {tp.description && <p>{tp.description}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title={t.cta_title} text={t.cta_text} label={t.cta_label} href="/kontak?keperluan=undangan_berbicara" />
</BaseV2>

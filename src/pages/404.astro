---
import BaseV2 from '../layouts/BaseV2.astro';
import Button from '../components/v2/Button.astro';
import { getContent } from '../lib/content';
import { fmtTitle } from '../lib/format';
const { page_404: p } = await getContent();
---
<BaseV2 title="Halaman tidak ditemukan" noindex>
  <section class="container notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="display display--lg" set:html={fmtTitle(p.title)}></h1>
    <p class="lead">{p.text}</p>
    <div class="hero__cta">
      <Button href="/" icon="arrow-right">Ke beranda</Button>
      <Button href="/artikel" variant="ghost">Baca artikel</Button>
    </div>
  </section>
</BaseV2>

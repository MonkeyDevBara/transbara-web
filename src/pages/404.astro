---
import Base from '../layouts/Base.astro';
---
<Base title="Halaman tidak ditemukan" noindex>
  <section class="section">
    <div class="container text-center" style="max-width: 40rem;">
      <span class="gold-rule center"></span>
      <h1 class="section-title">Halaman ini tidak ditemukan.</h1>
      <p class="section-intro mx-auto mb-4">Mungkin tautannya sudah berubah. Silakan kembali ke beranda atau jelajahi tulisan terbaru.</p>
      <div class="hero-ctas justify-content-center">
        <a href="/" class="btn btn-primary">Ke Beranda</a>
        <a href="/artikel" class="btn btn-secondary">Baca Artikel</a>
      </div>
    </div>
  </section>
</Base>

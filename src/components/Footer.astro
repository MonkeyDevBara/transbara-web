---
import type { Content } from '../lib/content';
import { SOCIAL_LABELS } from '../lib/data';
interface Props { content: Content }
const { content } = Astro.props;
const social = content.social as Record<string, string>;
const socials = Object.keys(SOCIAL_LABELS).map((k) => ({ key: k, label: SOCIAL_LABELS[k], url: social[k] || null }));
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container">
    <div class="row">
      <div class="col-lg-5 mb-5 mb-lg-0">
        <a href="/" class="wordmark mb-3">
          <span class="wm-name">{content.site.name}</span>
          <span class="wm-desc">{content.site.tagline}</span>
        </a>
        <p class="mt-3 mb-0" style="max-width: 26rem; color: rgba(255,255,255,.72);">{content.footer.description}</p>
      </div>
      <div class="col-6 col-lg-2 offset-lg-1">
        <h4>Jelajahi</h4>
        <ul>
          <li><a href="/">Beranda</a></li>
          <li><a href="/tentang">Tentang</a></li>
          <li><a href="/artikel">Artikel</a></li>
          <li><a href="/proyek">Proyek</a></li>
          <li><a href="/kontak">Kontak</a></li>
        </ul>
      </div>
      <div class="col-6 col-lg-2">
        <h4>Terhubung</h4>
        <ul>
          {socials.map((s) => (
            <li>
              {s.url
                ? <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
                : <span class="placeholder-link" title="Tautan belum diatur di Pengaturan Website">{s.label} (belum diatur)</span>}
            </li>
          ))}
        </ul>
      </div>
      <div class="col-lg-2 mt-4 mt-lg-0">
        <h4>Email</h4>
        {content.contact.email
          ? <a href={`mailto:${content.contact.email}`}>{content.contact.email}</a>
          : <span class="placeholder-link">Email belum diatur</span>}
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {content.footer.copyright}</span>
      {content.footer.note && <span>{content.footer.note}</span>}
    </div>
  </div>
</footer>

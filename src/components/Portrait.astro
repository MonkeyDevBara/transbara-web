---
import { getContent } from '../lib/content';
interface Props { caption?: string; eager?: boolean }
const { caption, eager = false } = Astro.props;
const { hero } = await getContent();
---
<figure class="portrait-frame">
  <div class="portrait">
    <img src={hero.portrait} alt={hero.portrait_alt} width="1600" height="2000" loading={eager ? 'eager' : 'lazy'} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

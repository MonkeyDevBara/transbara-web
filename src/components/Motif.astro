---
// Ornamen Islami sangat halus: satu bintang delapan (rub el hizb) bergaris tipis.
interface Props { class?: string; color?: string }
const { class: cls = 'motif', color = 'currentColor' } = Astro.props;
---
<svg class={cls} viewBox="0 0 200 200" fill="none" stroke={color} stroke-width="1" aria-hidden="true">
  <rect x="45" y="45" width="110" height="110" />
  <rect x="45" y="45" width="110" height="110" transform="rotate(45 100 100)" />
  <circle cx="100" cy="100" r="38" />
  <rect x="70" y="70" width="60" height="60" />
  <rect x="70" y="70" width="60" height="60" transform="rotate(45 100 100)" />
</svg>

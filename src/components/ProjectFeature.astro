---
import type { Project } from '../lib/data';
import Icon from './Icon.astro';
interface Props { project: Project; detailed?: boolean }
const { project, detailed = false } = Astro.props;
---
<article class="project-feature">
  <div>
    <div class="logo-tile">
      {project.logo_url
        ? <img src={project.logo_url} alt={`Logo ${project.name}`} />
        : <><span class="mono">{project.name}</span><span class="hint">Logo menyusul</span></>}
    </div>
  </div>
  <div>
    <div class="d-flex flex-wrap align-items-center mb-3" style="gap:.5rem">
      <span class="eyebrow mb-0">Proyek utama</span>
      {project.role && <span class="role-chip">Peran: {project.role}</span>}
    </div>
    <h3 class="h2 mb-3">{project.name}</h3>
    {project.summary && <p class="lead-serif" style="font-size:1.375rem">{project.summary}</p>}
    {project.description && <p style="color:#3A4452; max-width: 44rem;">{project.description}</p>}
    {detailed && project.contributions.length > 0 && (
      <div class="mt-4 mb-4" style="max-width: 44rem;">
        <h4 class="h6 text-uppercase mb-2" style="letter-spacing:.08em; font-size:.75rem;">Peran dan kontribusi</h4>
        <ul class="contrib-list">{project.contributions.map((c) => <li>{c}</li>)}</ul>
      </div>
    )}
    <div class="d-flex flex-wrap mt-3" style="gap:1.25rem">
      {project.url
        ? <a href={project.url} class="text-link" target="_blank" rel="noopener">Kunjungi {project.name} <Icon name="external" size={16} /></a>
        : <span class="text-muted-tw" style="font-size:.875rem">Tautan situs {project.name} belum diatur.</span>}
      {!detailed && <a href="/proyek" class="text-link">Lihat semua proyek <Icon name="arrow" size={16} /></a>}
    </div>
  </div>
</article>

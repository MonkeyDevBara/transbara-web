---
// Pop up promo sekali tampil untuk pengunjung baru. Logika: src/scripts/promo-popup.ts.
// Gambar tidak punya src sampai pop up benar-benar ditampilkan, jadi pengunjung lama tidak mengunduhnya.
---
<dialog class="promo" id="promo" aria-label="Promo Transbara Dev" data-href="https://dev.transbara.my.id" data-img="/v2/img/promo-dev.webp">
  <a class="promo__link" href="https://dev.transbara.my.id" data-claim>
    <img class="promo__img" alt="Punya ide digital? Wujudkan sekarang! Website profesional, aplikasi custom, AI custom. Dapatkan diskon spesial. Claim Promo." width="1200" height="800" decoding="async" />
  </a>
  <button class="promo__close" type="button" autofocus aria-label="Tutup promo" data-close>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" /></svg>
  </button>
</dialog>
<script>
  import '../../scripts/promo-popup.ts';
</script>

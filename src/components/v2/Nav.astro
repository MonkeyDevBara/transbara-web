---
import Icon from './Icon.astro';
interface Props { home?: boolean; wordmark?: string; ctaLabel?: string }
const { home = false, wordmark = 'Transbara', ctaLabel = 'Undang Saya as Speaker' } = Astro.props;
const p = home ? '' : '/';
const speakerHref = home ? '#kontak' : '/kontak?keperluan=undangan_berbicara';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Karya', href: `${p}#karya`, spy: 'karya' },
  { label: 'Pencapaian', href: `${p}#pencapaian`, spy: 'pencapaian', also: 'founder-story' },
  { label: 'Tentang', href: home ? '#tentang' : '/tentang', spy: 'tentang', current: path.startsWith('/tentang') },
  { label: 'Perjalanan', href: `${p}#perjalanan`, spy: 'perjalanan' },
  { label: 'Artikel', href: '/artikel', current: path.startsWith('/artikel') },
  { label: 'Kontak', href: home ? '#kontak' : '/kontak', spy: 'kontak', current: path.startsWith('/kontak') },
];
---
<header class="nav">
  <div class="container nav__in">
    <a class="wordmark" href="/" aria-label={`${wordmark}, ke beranda`}>{wordmark}<span class="dot">.</span></a>
    <nav class="nav__links" aria-label="Navigasi utama">
      <ul class="nav__list">
        {links.map((l) => (
          <li><a class="nav__link" href={l.href} data-spy={home ? l.spy : undefined} data-spy-also={home ? l.also : undefined} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav__right">
      <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true" title="Nyalakan atau matikan animasi">
        <span class="mt-bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="mt-label">Motion on</span>
      </button>
      <a class="nav__cta" href={speakerHref} data-open-form data-purpose="undangan_berbicara">{ctaLabel} <Icon name="arrow-ur" /></a>
      <button class="nav__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Buka menu"><Icon name="menu" /></button>
    </div>
  </div>
</header>

<div id="menu" class="menu" hidden role="dialog" aria-modal="true" aria-label="Menu">
  <div class="menu__head"><div class="container nav__in">
    <a class="wordmark" href="/">{wordmark}<span class="dot">.</span></a>
    <button class="nav__burger" type="button" data-menu-close aria-label="Tutup menu"><Icon name="close" /></button>
  </div></div>
  <ul class="menu__list">
    {links.map((l, i) => (<li><a class="menu__link" href={l.href} style={`--i:${i}`}><small>{String(i + 1).padStart(2, '0')}</small>{l.label}</a></li>))}
    <li><a class="menu__link" href={speakerHref} data-open-form data-purpose="undangan_berbicara" style={`--i:${links.length}`}><small>↗</small>{ctaLabel}</a></li>
  </ul>
  <div class="menu__foot">
    <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true" style="display:inline-flex"><span class="mt-bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="mt-label">Motion on</span></button>
  </div>
</div>

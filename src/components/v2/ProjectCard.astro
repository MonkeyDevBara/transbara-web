---
import Button from './Button.astro';
interface Props { name: string; role?: string | null; summary?: string | null; logo?: string | null; url?: string | null }
const { name, role, summary, logo, url } = Astro.props;
---
<article class="proj reveal">
  <div class="proj__top">
    <div class="proj__logo">{logo ? <img src={logo} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span aria-hidden="true">{name.trim().charAt(0).toUpperCase()}</span>}</div>
    {role && <span class="chip">{role}</span>}
  </div>
  <h3 class="proj__name">{name}</h3>
  {summary && <p class="proj__sum">{summary}</p>}
  {url && <Button href={url} variant="ghost" icon="arrow-ur" target="_blank" rel="noopener noreferrer" aria-label={`Kunjungi ${name}`}>Kunjungi</Button>}
</article>

---
import type { Article } from '../lib/data';
import { formatDate } from '../lib/data';
import Cover from './Cover.astro';
import SampleLabel from './SampleLabel.astro';

interface Props { article: Article; variant?: 'feature' | 'compact' | 'row' | 'text'; headingLevel?: 'h2' | 'h3' }
const { article, variant = 'compact', headingLevel = 'h3' } = Astro.props;
const href = `/artikel/${article.slug}`;
const H = headingLevel;
---
<article class:list={['a-card', `a-card-${variant}`]} data-category={article.category?.slug}>
  {variant !== 'text' && (
    <a href={href} class="cover-link" tabindex="-1" aria-hidden="true">
      <Cover article={article} shape={variant === 'feature' ? 'wide' : 'default'} />
    </a>
  )}
  <div>
    <div class="d-flex flex-wrap align-items-center" style="gap:.5rem; margin-top: 1rem;">
      {article.category && <a class="badge-cat" href={`/artikel?kategori=${article.category.slug}`}>{article.category.name}</a>}
      {article.is_sample && <SampleLabel />}
    </div>
    <H class="a-title"><a href={href}>{article.title}</a></H>
    {article.excerpt && <p class="a-excerpt">{article.excerpt}</p>}
    <div class="article-meta">
      <span><time datetime={article.published_at}>{formatDate(article.published_at)}</time></span>
      {article.reading_minutes && <span>{article.reading_minutes} menit baca</span>}
    </div>
  </div>
</article>

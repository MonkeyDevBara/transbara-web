---
import '../styles/main.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getContent } from '../lib/content';

interface Props { title?: string; description?: string; canonical?: string | null; ogImage?: string | null; noindex?: boolean }
const { title, description, canonical, ogImage, noindex = false } = Astro.props;
const content = await getContent();
const siteName = content.site.name;
const fullTitle = title ? `${title} | ${siteName}` : `${siteName} | ${content.site.tagline}`;
const desc = description ?? content.site.description;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:image" content={ogImage || content.site.og_image || content.hero.portrait} />
    <meta name="theme-color" content="#16325C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#konten" class="skip-link">Lewati ke konten</a>
    <Header content={content} />
    <main id="konten">
      <slot />
    </main>
    <Footer content={content} />
    <button class="back-to-top" type="button" aria-label="Kembali ke atas"><Icon name="arrow-up" /></button>
    <script>
      const btt = document.querySelector<HTMLButtonElement>('.back-to-top');
      const onScroll = () => btt?.classList.toggle('show', window.scrollY > 600);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      btt?.addEventListener('click', () => window.scrollTo({ top: 0 }));
    </script>
  </body>
</html>

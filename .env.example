# Salin ke .env lalu isi. JANGAN commit .env.
# Supabase Dashboard > Project Settings > API (atau "API Keys").
#
# Kedua nilai ini PUBLIK (tertanam di JavaScript browser saat build). Keamanan data dijaga oleh RLS,
# bukan oleh kerahasiaan key. Gunakan HANYA publishable/anon key. JANGAN PERNAH memasukkan
# service_role / secret key ke variabel ber-awalan PUBLIC_.
#
# Nilai dibaca saat `npm run build` (dan `npm run dev`). Ubah nilai => build ulang.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsional: URL publik situs (dipakai untuk tautan berbagi artikel). Bila kosong, memakai domain dari request.
# Pastikan Nginx meneruskan header Host.
PUBLIC_SITE_URL=https://DOMAIN-ANDA

# /etc/nginx/sites-available/transbara-web  (ganti DOMAIN-ANDA, lalu: certbot --nginx)
# Menggantikan public/_headers milik Cloudflare Pages: header keamanan dan noindex untuk /admin.

server {
    listen 80;
    server_name DOMAIN-ANDA;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Header keamanan (diulang di location yang punya add_header sendiri, karena nginx tidak mewarisinya)
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Admin: jangan diindeks dan jangan di-cache
    location ^~ /admin {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-cache" always;
        proxy_pass http://127.0.0.1:4321;
        include /etc/nginx/proxy_params;
    }

    # Aset ber-hash dari Astro: cache panjang
    location ^~ /_astro/ {
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        proxy_pass http://127.0.0.1:4321;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:4321;
        include /etc/nginx/proxy_params;   # meneruskan Host dan X-Forwarded-*
    }
}
